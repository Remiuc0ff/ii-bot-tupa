import asyncio
import logging
from datetime import datetime, timezone, timedelta
from telethon import events
from telethon.tl.types import Message
from .. import loader, utils

logger = logging.getLogger(__name__)


@loader.tds
class BotAutomatorMod(loader.Module):
    """Пошаговая цикличная автоматизация действий и кнопок в ботах + автоочистка сообщений"""

    strings = {
        "name": "BotAutomator",
        "cfg_bot": "Юзернейм или ID целевого бота (например, @example_bot)",
        "cfg_buttons": "Список текстов кнопок СТРОГО по порядку нажатия (например: 5, Запустить)",
        "cfg_trigger": "Текст от бота о полном завершении (перезапуск цикла)",
        "cfg_delay": "Задержка между нажатиями кнопок (в секундах)",
        "cfg_step_delay": "Задержка перед отправкой 2-го сообщения и новым кругом (в секундах)",
        "cfg_cleanup_enabled": "Включить автоматическое удаление свежих сообщений (< 10 часов)",
        "no_bot": "❌ <b>Целевой бот не настроен в конфиге!</b> Используй <code>.config BotAutomator</code>",
        "no_text": "❌ <b>Текст для отправки не задан!</b> Укажи его через <code>.btext &lt;текст&gt;</code> или сразу <code>.bstart &lt;текст&gt;</code>",
        "text_set": "✅ <b>Текст для цикла сохранен:</b>\n<code>{}</code>",
        "already_running": "⚠️ <b>Цикл уже запущен!</b> Останови его через <code>.bstop</code>",
        "started": (
            "🚀 <b>Автоматизация запущена!</b>\n"
            "🤖 <b>Бот:</b> <code>{}</code> (ID: <code>{}</code>)\n"
            "💬 <b>Текст (по 2 подхода):</b> <code>{}</code>\n"
            "🔘 <b>Очередь кнопок:</b> <code>{}</code>\n"
            "🎯 <b>Триггер нового круга:</b> <code>{}</code>\n"
            "🧹 <b>Автоочистка (<10ч, раз в час):</b> <code>{}</code>"
        ),
        "stopped": "🛑 <b>Автоматизация остановлена.</b>",
        "not_running": "ℹ️ <b>Автоматизация сейчас не работает.</b>",
        "bot_error": "❌ <b>Не удалось найти бота:</b> <code>{}</code>",
    }

    def __init__(self):
        self.config = loader.ModuleConfig(
            loader.ConfigValue(
                "target_bot",
                "",
                lambda: self.strings["cfg_bot"],
                validator=loader.validators.String(),
            ),
            loader.ConfigValue(
                "buttons",
                ["5", "Запустить"],
                lambda: self.strings["cfg_buttons"],
                validator=loader.validators.Series(loader.validators.String()),
            ),
            loader.ConfigValue(
                "done_trigger",
                "✅ Готово",
                lambda: self.strings["cfg_trigger"],
                validator=loader.validators.String(),
            ),
            loader.ConfigValue(
                "delay",
                1.5,
                lambda: self.strings["cfg_delay"],
                validator=loader.validators.Float(minimum=0.3),
            ),
            loader.ConfigValue(
                "step_delay",
                3.0,
                lambda: self.strings["cfg_step_delay"],
                validator=loader.validators.Float(minimum=0.5),
            ),
            loader.ConfigValue(
                "cleanup_enabled",
                True,
                lambda: self.strings["cfg_cleanup_enabled"],
                validator=loader.validators.Boolean(),
            ),
        )
        self.running = False
        self.target_id = None
        self.loop_task = None
        self.cleanup_task = None
        self.sub_step_done = asyncio.Event()
        self.cycle_done = asyncio.Event()
        self._click_lock = asyncio.Lock()
        self._btn_index = 0
        self._last_bot_msg = None

    async def client_ready(self, client, db):
        self._client = client
        self._db = db
        self.running = False

        self._client.add_event_handler(
            self._on_message_edited,
            events.MessageEdited(incoming=True),
        )

    async def on_unload(self):
        self.running = False
        if self.loop_task:
            self.loop_task.cancel()
        if self.cleanup_task:
            self.cleanup_task.cancel()
        self._client.remove_event_handler(
            self._on_message_edited,
            events.MessageEdited(incoming=True),
        )

    @loader.command()
    async def btext(self, message: Message):
        """<текст> — Задать текст для отправки боту"""
        args = utils.get_args_raw(message)
        if not args:
            current = self.get("spam_text", "")
            if current:
                await utils.answer(
                    message,
                    self.strings["text_set"].format(utils.escape_html(current)),
                )
            else:
                await utils.answer(message, self.strings["no_text"])
            return

        self.set("spam_text", args)
        await utils.answer(
            message, self.strings["text_set"].format(utils.escape_html(args))
        )

    @loader.command()
    async def bstart(self, message: Message):
        """[текст] — Запустить цикл отправки и нажатия кнопок в боте"""
        if self.running:
            await utils.answer(message, self.strings["already_running"])
            return

        args = utils.get_args_raw(message)
        if args:
            self.set("spam_text", args)

        spam_text = self.get("spam_text", "")
        if not spam_text:
            await utils.answer(message, self.strings["no_text"])
            return

        raw_bot = str(self.config["target_bot"]).strip()
        if not raw_bot:
            await utils.answer(message, self.strings["no_bot"])
            return

        clean_bot = (
            raw_bot.replace("https://", "")
            .replace("http://", "")
            .replace("t.me/", "")
            .strip("/")
        )

        try:
            if clean_bot.lstrip("-").isdigit():
                entity = await self._client.get_entity(int(clean_bot))
            else:
                entity = await self._client.get_entity(clean_bot)
            self.target_id = entity.id
        except Exception as e:
            await utils.answer(
                message,
                self.strings["bot_error"].format(utils.escape_html(str(e))),
            )
            return

        self.running = True
        self.sub_step_done.clear()
        self.cycle_done.clear()
        self.loop_task = asyncio.create_task(self._runner_loop())
        
        if self.config["cleanup_enabled"]:
            self.cleanup_task = asyncio.create_task(self._cleanup_loop())

        buttons_str = (
            " ➔ ".join(self.config["buttons"])
            if self.config["buttons"]
            else "Нет"
        )
        await utils.answer(
            message,
            self.strings["started"].format(
                utils.escape_html(raw_bot),
                self.target_id,
                utils.escape_html(spam_text),
                utils.escape_html(buttons_str),
                utils.escape_html(self.config["done_trigger"]),
                "Включена" if self.config["cleanup_enabled"] else "Выключена",
            ),
        )

    @loader.command()
    async def bstop(self, message: Message):
        """— Остановить цикл автоматизации"""
        if not self.running:
            await utils.answer(message, self.strings["not_running"])
            return

        self.running = False
        self.sub_step_done.set()
        self.cycle_done.set()
        if self.loop_task:
            self.loop_task.cancel()
            self.loop_task = None
        if self.cleanup_task:
            self.cleanup_task.cancel()
            self.cleanup_task = None

        await utils.answer(message, self.strings["stopped"])

    async def _runner_loop(self):
        try:
            while self.running:
                self.cycle_done.clear()
                spam_text = self.get("spam_text", "")
                step_delay = float(self.config["step_delay"])
                target_buttons = [
                    str(b).strip()
                    for b in self.config["buttons"]
                    if str(b).strip()
                ]

                for step in range(2):
                    if not self.running:
                        return

                    self.sub_step_done.clear()
                    self._btn_index = 0
                    self._last_bot_msg = None

                    await self._client.send_message(self.target_id, spam_text)

                    if target_buttons:
                        try:
                            await asyncio.wait_for(
                                self.sub_step_done.wait(), timeout=40.0
                            )
                        except asyncio.TimeoutError:
                            pass

                    if not self.running:
                        return

                    if step == 0:
                        await asyncio.sleep(step_delay)

                await self.cycle_done.wait()

                if not self.running:
                    return

                await asyncio.sleep(step_delay)

        except asyncio.CancelledError:
            pass
        except Exception as e:
            logger.error(f"[BotAutomator] Ошибка в цикле: {e}")
            self.running = False

    async def _cleanup_loop(self):
        """Фоновая задача: удаляет сообщения моложе 10 часов каждый 1 час"""
        try:
            # Небольшая пауза при старте, чтобы не спамить запросами сразу
            await asyncio.sleep(10)
            while self.running:
                if self.target_id:
                    try:
                        now = datetime.now(timezone.utc)
                        threshold = now - timedelta(hours=10)
                        messages_to_delete = []

                        async for msg in self._client.iter_messages(self.target_id, limit=100):
                            if msg.date:
                                # Если дата сообщения позже порога (т.е. оно создано менее 10 часов назад)
                                if msg.date > threshold:
                                    messages_to_delete.append(msg.id)
                                else:
                                    # Так как итератор идет от новых к старым, как только встретили сообщение старше 10 часов,
                                    # все следующие будут еще старше. Но проверим и более старые на всякий случай или остановим?
                                    # Оставим проверку всех в пределах лимита на случай разброса, либо просто фильтруем.
                                    pass

                        if messages_to_delete:
                            # Удаляем пачками по 100 штук (Telegram лимит)
                            for i in range(0, len(messages_to_delete), 100):
                                chunk = messages_to_delete[i:i+100]
                                await self._client.delete_messages(self.target_id, chunk)
                                await asyncio.sleep(0.5)
                    except Exception as e:
                        logger.debug(f"[BotAutomator] Ошибка автоочистки: {e}")

                # Ждем ровно 1 час перед следующей чисткой
                await asyncio.sleep(3600)
        except asyncio.CancelledError:
            pass

    def _find_button(self, message: Message, target_text: str):
        if not getattr(message, "buttons", None):
            return None

        target_lower = target_text.lower()

        for row in message.buttons:
            for btn in row:
                b_text = (getattr(btn, "text", "") or "").strip().lower()
                if b_text == target_lower or b_text == f"• {target_lower}":
                    return btn

        for row in message.buttons:
            for btn in row:
                b_text = (getattr(btn, "text", "") or "").strip().lower()
                if target_lower in b_text:
                    return btn

        return None

    async def _handle_bot_response(self, message: Message):
        if not self.running or not self.target_id:
            return

        if not isinstance(message, Message):
            return

        chat_id = getattr(message, "chat_id", None)
        sender_id = getattr(message, "sender_id", None)
        if chat_id != self.target_id and sender_id != self.target_id:
            return

        text = getattr(message, "raw_text", "") or ""
        trigger = str(self.config["done_trigger"]).strip()

        if trigger and trigger.lower() in text.lower():
            self.cycle_done.set()

        if getattr(message, "buttons", None):
            self._last_bot_msg = message
            if not self._click_lock.locked():
                asyncio.create_task(self._process_buttons_queue())

    async def _process_buttons_queue(self):
        async with self._click_lock:
            target_buttons = [
                str(b).strip()
                for b in self.config["buttons"]
                if str(b).strip()
            ]
            if not target_buttons:
                self.sub_step_done.set()
                return

            delay = float(self.config["delay"])

            while self.running and self._btn_index < len(target_buttons):
                msg = self._last_bot_msg
                if not msg:
                    break

                current_target = target_buttons[self._btn_index]
                btn = self._find_button(msg, current_target)

                if not btn:
                    break

                await asyncio.sleep(delay)
                if not self.running:
                    return

                if self._last_bot_msg:
                    fresh_btn = self._find_button(self._last_bot_msg, current_target)
                    if fresh_btn:
                        btn = fresh_btn

                try:
                    await btn.click()
                except Exception as e:
                    logger.debug(f"[BotAutomator] Ошибка клика по '{current_target}': {e}")

                self._btn_index += 1

            if self._btn_index >= len(target_buttons):
                self.sub_step_done.set()

    @loader.watcher("in")
    async def watcher(self, message: Message):
        await self._handle_bot_response(message)

    async def _on_message_edited(self, event):
        if getattr(event, "message", None):
            await self._handle_bot_response(event.message)
